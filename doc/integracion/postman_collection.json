              "raw": "{\n  \"transactions\": [\n    {\n      \"reference_type\": \"PURCHASE_ORDER\",\n      \"reference_id\": \"OC-2026-00201\",\n      \"reason_code\": \"COMPRA\",\n      \"warehouse_id\": \"{{warehouse_id}}\",\n      \"zone_id\": \"{{zone_id}}\",\n      \"items\": [\n        {\n          \"product_id\": \"{{product_id}}\",\n          \"quantity\": 20,\n          \"unit_cost\": 15500.00\n        }\n      ]\n    },\n    {\n      \"reference_type\": \"PURCHASE_ORDER\",\n      \"reference_id\": \"OC-2026-00202\",\n      \"reason_code\": \"COMPRA\",\n      \"warehouse_id\": \"{{warehouse_id}}\",\n      \"zone_id\": \"{{zone_id}}\",\n      \"items\": [\n        {\n          \"product_id\": \"{{product_id}}\",\n          \"quantity\": 15,\n          \"unit_cost\": 16200.00\n        }\n      ]\n    }\n  ]\n}"
