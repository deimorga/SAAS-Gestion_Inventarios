# .env.prod.example — Producción
# Copiar a .env en /root/inventory-saas/ y completar TODOS los valores.
# NUNCA commitear el .env real al repositorio.
#
# Generar secrets:
#   openssl rand -hex 32   → JWT_SECRET_KEY, STORAGE_SECRET
#   openssl rand -hex 24   → POSTGRES_PASSWORD, REDIS_PASSWORD
#   openssl rand -hex 20   → ADMIN_BOOTSTRAP_SECRET

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=inv_prod_user
POSTGRES_PASSWORD=CHANGEME_strong_db_password
POSTGRES_DB=inventory_prod

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGEME_redis_password

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGEME_openssl_rand_hex_32

# ── Admin Bootstrap ───────────────────────────────────────────────────────────
# Vaciar (dejar en blanco) después de crear el primer super_admin.
ADMIN_BOOTSTRAP_SECRET=CHANGEME_bootstrap_secret

# ── NiceGUI Admin Portal ──────────────────────────────────────────────────────
STORAGE_SECRET=CHANGEME_nicegui_storage_secret_hex32

# ── Email — Resend ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_REAL_PRODUCTION_KEY
RESEND_FROM_EMAIL=noreply@micronuba.com
RESEND_FROM_NAME=MicroNuba

# ── URLs ──────────────────────────────────────────────────────────────────────
# URL base para los links de activación en emails de bienvenida
ACTIVATION_BASE_URL=https://admin.inventarios.micronuba.com
