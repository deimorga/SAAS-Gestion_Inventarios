# .env.staging.example — Staging
# Copiar a .env en /root/inventory-saas-staging/ y completar.
# Los secrets DEBEN ser distintos a los de producción — nunca compartir.
#
# Generar secrets:
#   openssl rand -hex 32   → JWT_SECRET_KEY, STORAGE_SECRET
#   openssl rand -hex 24   → POSTGRES_PASSWORD, REDIS_PASSWORD
#   openssl rand -hex 20   → ADMIN_BOOTSTRAP_SECRET

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Rol owner: crea el esquema y corre las migraciones. Es superusuario.
POSTGRES_USER=inv_staging_user
POSTGRES_PASSWORD=CHANGEME_staging_db_password
POSTGRES_DB=inventory_staging

# Rol de la aplicación: sin superuser ni BYPASSRLS, para que las políticas RLS
# se apliquen de verdad. Se crea con infra/postgres/create_app_role.sh y la API
# aborta el arranque si detecta que puede saltarse RLS.
APP_DB_USER=inv_app
APP_DB_PASSWORD=CHANGEME_staging_app_db_password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGEME_staging_redis_password

# ── JWT ───────────────────────────────────────────────────────────────────────
# Secret diferente al de prod
JWT_SECRET_KEY=CHANGEME_staging_jwt_secret_hex32

# ── Admin Bootstrap ───────────────────────────────────────────────────────────
# En staging puede mantenerse activo para facilitar resets de datos de prueba.
ADMIN_BOOTSTRAP_SECRET=CHANGEME_staging_bootstrap_secret

# ── NiceGUI Admin Portal ──────────────────────────────────────────────────────
STORAGE_SECRET=CHANGEME_staging_nicegui_secret

# ── Email — Resend (staging) ──────────────────────────────────────────────────
# Opción A: usar API key real con dominio de prueba verificado en Resend.
# Opción B: dejar placeholder si se implementa SMTP en tasks.py para APP_ENV=staging.
RESEND_API_KEY=re_staging_key_or_placeholder
RESEND_FROM_EMAIL=staging@micronuba.net
RESEND_FROM_NAME=MicroNuba Staging

# ── URLs ──────────────────────────────────────────────────────────────────────
ACTIVATION_BASE_URL=https://staging-admin.inventarios.micronuba.net
